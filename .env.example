# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/staysphere

# Auth — use a long random string in any deployed environment
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173

# Seed admin account (used only by "npm run seed:admin")
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@staysphere.in
SEED_ADMIN_PHONE=9000000000
SEED_ADMIN_PASSWORD=change-this-password
